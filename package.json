{
  "name": "gab-syntax-highlighting",
  "displayName": "GAB Syntax Highlighting",
  "description": "Extension that gives syntax highlighting for GAB ",
  "version": "0.0.1",
  "main": "./out/extension.js",
  "license": "MIT",
  "categories": ["Programming Languages", "Themes"],
  "icon": "images/gss.png",
  "keywords": ["GAB", "GAB Syntax Highlighting", "GAB Theme", "GAB Syntax", "GAB Syntax Highlighting Theme"],
  "engines": {
    "vscode": "^1.80.0"
  },
  "contributes": {
    "languages": [
      {
        "id": "gab",
        "aliases": [
          "GAB",
          "gab"
        ],
        "extensions": [
          ".g2u",
          ".g2p",
          ".g2c",
          ".gas"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "gab",
        "scopeName": "source.gab",
        "path": "./syntaxes/gab.tmLanguage.json"
      }
    ],
    "themes": [
      {
        "label": "GAB Theme",
        "uiTheme": "vs-dark",
        "path": "./themes/gab-theme.json"
      }
    ],
    "commands": [
      {
        "command": "gab.customizeTheme",
        "title": "Customize GAB Theme"
      }
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/cwells611/GAB_Extension.git"
  },
  "devDependencies": {
    "@types/vscode": "^1.80.0",
    "esbuild": "^0.28.0",
    "typescript": "^6.0.3"
  }, 
  "scripts": {
    "build": "tsc", 
    "watch": "tsc --watch", 
    "vscode:prepublish": "npm run build"
  }, 
  "activationEvents": ["onCommand:gab.customizeTheme"]
}
